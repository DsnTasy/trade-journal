# Copy this file to ".env" and fill in the values. NEVER share or commit .env.

# Anthropic (Claude) API key: needed for product pages and ad scripts (phase 5).
# Get one at https://console.anthropic.com → API Keys → Create Key.
ANTHROPIC_API_KEY=

# Optional (phase 2): Meta Ad Library API token for ad-saturation data. See README.
META_AD_LIBRARY_TOKEN=

# Shopify (phase 7): from your app in the Shopify Dev Dashboard (dev.shopify.com) → Settings.
# Put your store's subdomain in config.yaml → store.shop. See README "Connect Shopify".
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if you already have an older Admin API access token from a legacy custom app:
SHOPIFY_ACCESS_TOKEN=

# Added later (leave blank for now):
# CJ_DROPSHIPPING_API_KEY=
